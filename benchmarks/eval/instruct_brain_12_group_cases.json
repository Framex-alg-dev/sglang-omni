{
  "schema_version": 1,
  "tools": {
    "perform_action": {"name": "perform_action", "description": "执行受支持身体动作", "parameters": {"action": "string", "hand": "left|right|both 可选"}},
    "set_expression": {"name": "set_expression", "description": "设置面部表情", "parameters": {"expression": "string"}},
    "start_singing": {"name": "start_singing", "description": "开始唱歌；song 必填", "parameters": {"song": "string", "segment": "string 可选"}},
    "modify_task": {"name": "modify_task", "description": "修改运行中任务", "parameters": {"task_id": "string", "changes": "object"}},
    "cancel_task": {"name": "cancel_task", "description": "取消明确任务", "parameters": {"task_id": "string"}},
    "pause_task": {"name": "pause_task", "description": "暂停支持暂停的任务", "parameters": {"task_id": "string"}},
    "resume_task": {"name": "resume_task", "description": "恢复支持恢复的任务", "parameters": {"task_id": "string"}},
    "restart_task": {"name": "restart_task", "description": "从头重启任务", "parameters": {"task_id": "string"}},
    "query_task_status": {"name": "query_task_status", "description": "查询任务真实状态", "parameters": {"task_id": "string"}},
    "play_media": {"name": "play_media", "description": "播放目录项目", "parameters": {"item_id": "string"}},
    "stop_media": {"name": "stop_media", "description": "停止本会话媒体播放", "parameters": {"task_id": "string"}},
    "set_volume": {"name": "set_volume", "description": "修改播放音量", "parameters": {"task_id": "string", "level": "number"}},
    "search_catalog": {"name": "search_catalog", "description": "搜索媒体目录", "parameters": {"query": "string"}},
    "send_proactive_message": {"name": "send_proactive_message", "description": "在策略授权时发送主动提醒", "parameters": {"text": "string"}},
    "create_reminder": {"name": "create_reminder", "description": "创建提醒", "parameters": {"time": "string", "content": "string"}},
    "get_order": {"name": "get_order", "description": "查询订单", "parameters": {"order_id": "string"}},
    "list_orders": {"name": "list_orders", "description": "列出当前已认证用户订单", "parameters": {}},
    "lookup_memory": {"name": "lookup_memory", "description": "查询已授权会话记忆", "parameters": {"key": "string"}},
    "get_weather": {"name": "get_weather", "description": "查询天气", "parameters": {"city": "string"}}
  },
