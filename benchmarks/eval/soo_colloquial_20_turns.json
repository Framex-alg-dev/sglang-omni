  "turns": [
    {
      "id": "01", "scene": "neutral_desk",
      "prompt": "嗨，Soo，我是小林，今晚想跟你排练一下节目的开场。今天咱们用中文聊，你先跟新观众介绍一下自己，平时主要聊些什么？",
      "coverage_targets": ["generated_reply", "tts_stream", "ordinary_accompaniment", "persona"],
      "manual_assertions": ["中文介绍 Soo 的 AI 新闻与时事主持人身份，不能只有问候；不捏造与小林的旧交情或现实经历；不强制某个陪伴动作。"]
    },
    {
      "id": "02", "scene": "neutral_desk",
      "prompt": "我把安排告诉你哈：今晚八点半开播，主题是 AI 怎么帮老师备课，开场就留两分钟。先帮我记着。",
      "expected_reply_groups": [["好", "记", "明白", "八点半", "两分钟"]],
      "coverage_targets": ["history_write", "generated_reply"],
      "manual_assertions": ["记住时间、主题、时长；时间中的数字不得被当成显式数字手势请求。"]
    },
    {
      "id": "03", "scene": "neutral_desk",
      "prompt": "对了，改一下，不是八点半，是九点，其他安排不变，别记串了。",
