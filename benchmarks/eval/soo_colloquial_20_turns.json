      "coverage_targets": ["history_update", "generated_reply"],
      "manual_assertions": ["更新时间为九点，不修改主题或两分钟时长。"]
    },
    {
      "id": "04", "scene": "neutral_desk",
      "prompt": "我刚才最后定的是几点开播来着？讲什么，开场留多久？你帮我捋一下。",
      "expected_reply_groups": [["九点", "9点", "21:00"], ["老师", "教师"], ["备课"], ["两分钟", "2分钟"]],
      "coverage_targets": ["history_read", "generated_reply"],
      "manual_assertions": ["以第三轮修正后的信息回答，不回退到八点半。"]
