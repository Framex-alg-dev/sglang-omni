# Copy to deploy/realtime-executors.env, replace the value with a random
# deployment secret, then chmod 600.  Both GPU0 and GPU1 load the same token;
# the internal executor remains bound to 127.0.0.1.
SGLANG_OMNI_INTERNAL_MODEL_TOKEN=replace-with-a-random-secret

# Shared only by the CPU inference gateway and the private Action Omni service.
SGLANG_OMNI_ACTION_DECISION_TOKEN=replace-with-a-different-random-secret

# Complete speech.request text is synthesized exactly once. The request carries
# its character voice, so the gateway only needs the local PCM streaming endpoint.
SGLANG_OMNI_GATEWAY_SPEECH_URL=http://127.0.0.1:50001/v1/tts/stream
SGLANG_OMNI_GATEWAY_SPEECH_TIMEOUT_SECONDS=60

# The action token may be omitted to reuse the internal service token. Use a
# separate value when the gateway and Action Omni service have separate trust
# boundaries.
