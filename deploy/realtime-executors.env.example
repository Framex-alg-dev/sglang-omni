# Copy to deploy/realtime-executors.env, replace the value with a random
# deployment secret, then chmod 600.  Both GPU0 and GPU1 load the same token;
# the internal executor remains bound to 127.0.0.1.
SGLANG_OMNI_INTERNAL_MODEL_TOKEN=replace-with-a-random-secret

# GPU0 uses enforce on this pre-launch branch.  The early GPU1 reply stays
# private until the unchanged GPU0 intent/history/knowledge/action gates accept
# it; rejected requests are discarded and rebuilt through the authoritative
# reply path, which is also routed to GPU1.
