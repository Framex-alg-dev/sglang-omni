# sglang-omni -> Knowledge Service runtime configuration.
# Copy this file to deploy/realtime-knowledge.env and keep the real token local.

SGLANG_OMNI_REALTIME_KNOWLEDGE_ENABLED=true
SGLANG_OMNI_REALTIME_KNOWLEDGE_URL=http://127.0.0.1:8090
SGLANG_OMNI_REALTIME_KNOWLEDGE_TOKEN=replace-with-service-token
SGLANG_OMNI_REALTIME_KNOWLEDGE_DEFAULT_TENANT=local-dev

# Total per-turn Knowledge budget, including Prepare and Commit.
SGLANG_OMNI_REALTIME_KNOWLEDGE_TURN_TIMEOUT_MS=1200

# Start Knowledge Prepare in parallel with the sglang reply/action routers.
SGLANG_OMNI_REALTIME_KNOWLEDGE_SPECULATIVE_ENABLED=true
# Keep this part of the total budget available for Commit.
SGLANG_OMNI_REALTIME_KNOWLEDGE_COMMIT_RESERVE_MS=200
# Continue synchronizing the state token for this long after an uncertain Commit.
SGLANG_OMNI_REALTIME_KNOWLEDGE_COMMIT_RECOVERY_TIMEOUT_MS=500
# 产品调试用的通用回复/动作文本覆盖目录；空文件自动回退仓库默认。
SGLANG_OMNI_RUNTIME_PROMPT_DIR=runtime
