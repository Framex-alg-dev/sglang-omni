[Unit]
Description=SGLang-Omni GPU3 classifier and task Brain on 18006
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=user
Group=user
WorkingDirectory=/data/fanshide/sglang-omni-dev
Environment=XDG_CACHE_HOME=/data/fanshide/.cache
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=SGLANG_OMNI_QWEN3_CHAT_TEMPLATE_MODEL=/data/models/Qwen3-Omni-30B-A3B-Instruct
Environment=SGLANG_OMNI_SERVICE_ROLE=decision-services
Environment=SGLANG_OMNI_SERVICE_INSTANCE_ID=sglang-omni-gpu3-decision-services
Environment=SGLANG_OMNI_STRICT_PORT=1
Environment=SGLANG_OMNI_ACTION_WARMUP=0
Environment=PYTHONPATH=/data/fanshide/sglang-omni-dev
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/data/fanshide/sglang-omni-dev/.venv/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=/data/fanshide/sglang-omni-dev/deploy/gpu3-decision-services.env
UnsetEnvironment=HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy
ExecStart=/data/fanshide/sglang-omni-dev/.venv/bin/sgl-omni serve --config ${GPU3_DECISION_SERVICES_CONFIG} --model-name ${GPU3_DECISION_SERVICES_MODEL_NAME} --host 127.0.0.1 --port ${GPU3_DECISION_SERVICES_PORT} --log-level info
Restart=always
RestartSec=10
TimeoutStartSec=infinity
TimeoutStopSec=120
KillMode=control-group
LimitMEMLOCK=infinity
LimitNOFILE=1048576
TasksMax=infinity
StandardOutput=append:/data/fanshide/sglang-omni-dev/logs/sglang-omni-gpu3.log
StandardError=append:/data/fanshide/sglang-omni-dev/logs/sglang-omni-gpu3.log
SyslogIdentifier=sglang-omni-gpu3-task-decision

[Install]
WantedBy=multi-user.target
