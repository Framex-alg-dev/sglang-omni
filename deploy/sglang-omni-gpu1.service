[Unit]
Description=SGLang-Omni GPU1 private realtime reply executor on 18005
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=user
Group=user
WorkingDirectory=/data/fanshide/sglang-omni
Environment=HOME=/data/fanshide/.runtime-home
Environment=XDG_CACHE_HOME=/data/fanshide/.cache
Environment=FLASHINFER_WORKSPACE_DIR=/data/fanshide/.cache/flashinfer
Environment=TORCHINDUCTOR_CACHE_DIR=/data/fanshide/.cache/torchinductor
Environment=CUDA_HOME=/usr/local/cuda
Environment=CUDA_VISIBLE_DEVICES=1
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=SGLANG_OMNI_QWEN3_CHAT_TEMPLATE_MODEL=/data/models/Qwen3-Omni-30B-A3B-Instruct
Environment=SGLANG_OMNI_REALTIME_LOG_DIR=/data/fanshide/sglang-omni/logs/realtime
Environment=SGLANG_OMNI_REALTIME_LOG_TIMEZONE=Asia/Shanghai
Environment=SGLANG_OMNI_REALTIME_LOG_MAX_FILE_MB=128
Environment=SGLANG_OMNI_SERVICE_INSTANCE_ID=sglang-omni-gpu1-reply
Environment=SGLANG_OMNI_STRICT_PORT=1
Environment=SGLANG_OMNI_SCOPED_RADIX_CACHE=1
Environment=SGLANG_OMNI_INTERNAL_MODEL_API=1
Environment=SGLANG_OMNI_ACTION_WARMUP=0
# The launcher requires a positive budget.  A 1 ms budget makes the
# action-catalog prewarm best-effort/no-op on this reply-only executor.
Environment=SGLANG_OMNI_GLOBAL_ACTION_PREWARM_BUDGET_S=0.001
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/data/fanshide/sglang-omni/.venv/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=/data/fanshide/sglang-omni/deploy/realtime-executors.env
UnsetEnvironment=HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy
ExecStart=/data/fanshide/sglang-omni/.venv/bin/sgl-omni serve --config /data/fanshide/sglang-omni/deploy/config_reply_gpu.yaml --host 127.0.0.1 --port 18005 --log-level info
Restart=always
RestartSec=10
TimeoutStartSec=infinity
TimeoutStopSec=120
KillMode=control-group
LimitMEMLOCK=infinity
LimitNOFILE=1048576
TasksMax=infinity
StandardOutput=append:/data/fanshide/sglang-omni/logs/sglang-omni-gpu1.log
StandardError=append:/data/fanshide/sglang-omni/logs/sglang-omni-gpu1.log
SyslogIdentifier=sglang-omni-gpu1

[Install]
WantedBy=multi-user.target
