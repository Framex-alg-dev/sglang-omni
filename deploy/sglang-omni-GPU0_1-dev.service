[Unit]
Description=SGLang-Omni dev dual GPU realtime service on 18004/18005
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=user
Group=user
WorkingDirectory=/data/fanshide/sglang-omni-dev
Environment=HOME=/data/fanshide/.runtime-home
Environment=XDG_CACHE_HOME=/data/fanshide/.cache
Environment=FLASHINFER_WORKSPACE_DIR=/data/fanshide/.cache/flashinfer
Environment=TORCHINDUCTOR_CACHE_DIR=/data/fanshide/.cache/torchinductor
Environment=CUDA_HOME=/usr/local/cuda
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=SGLANG_OMNI_QWEN3_CHAT_TEMPLATE_MODEL=/data/models/Qwen3-Omni-30B-A3B-Instruct
Environment=PYTHONPATH=/data/fanshide/sglang-omni-dev
Environment=SGLANG_OMNI_REALTIME_LOG_DIR=/data/fanshide/.runtime-home/sglang-omni-dev/realtime
Environment=SGLANG_OMNI_REALTIME_LOG_TIMEZONE=Asia/Shanghai
Environment=SGLANG_OMNI_REALTIME_LOG_MAX_FILE_MB=128
Environment=SGLANG_OMNI_STRICT_PORT=1
Environment=SGLANG_OMNI_SCOPED_RADIX_CACHE=1
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/data/fanshide/sglang-omni-dev/.venv/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=/data/fanshide/sglang-omni-dev/deploy/realtime-knowledge.env
EnvironmentFile=/data/fanshide/sglang-omni-dev/deploy/realtime-executors.env
UnsetEnvironment=HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy
ExecStart=/data/fanshide/sglang-omni-dev/deploy/launch_dual_gpu_dev.sh
Restart=always
RestartSec=10
TimeoutStartSec=infinity
TimeoutStopSec=180
KillMode=control-group
LimitMEMLOCK=infinity
LimitNOFILE=1048576
TasksMax=infinity
StandardOutput=append:/data/fanshide/sglang-omni-dev/logs/sglang-omni-GPU0_1-dev.log
StandardError=append:/data/fanshide/sglang-omni-dev/logs/sglang-omni-GPU0_1-dev.log
SyslogIdentifier=sglang-omni-GPU0_1-dev

[Install]
WantedBy=multi-user.target
