# Copy to gpu3-decision-services.env, replace secrets, and chmod 600.
CUDA_VISIBLE_DEVICES=3
SGLANG_OMNI_TASK_CLASSIFICATION_TOKEN=replace-with-a-random-secret
SGLANG_OMNI_TASK_BRAIN_TOKEN=replace-with-an-independent-random-secret
SGLANG_OMNI_MODEL_VERSION=qwen3-omni-30b-a3b-fp8-prompted-v1
SGLANG_OMNI_TASK_CLASSIFICATION_MODEL_VERSION=omni-turn-router-prompt-v6
SGLANG_OMNI_TASK_BRAIN_MODEL_VERSION=task-brain-system-v2
SGLANG_OMNI_TASK_BRAIN_MAX_CONCURRENCY=2
SGLANG_OMNI_TASK_BRAIN_MAX_WAITING=32
SGLANG_OMNI_TASK_BRAIN_MAX_BODY_BYTES=67108864
GPU3_DECISION_SERVICES_CONFIG=/data/fanshide/sglang-omni-dev/deploy/config_gpu3_decision_services.yaml
GPU3_DECISION_SERVICES_MODEL_NAME=qwen3-omni-gpu3-task-decision
GPU3_DECISION_SERVICES_PORT=18006
