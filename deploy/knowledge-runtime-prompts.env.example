# Resolve selected Knowledge bundles once at service startup. Never store production credentials here.
KNOWLEDGE_PROMPT_ENABLED=false
KNOWLEDGE_PROMPT_URL=http://knowledge.internal:8090
KNOWLEDGE_PROMPT_TENANT_ID=
KNOWLEDGE_PROMPT_RUNTIME_TOKEN=
KNOWLEDGE_PROMPT_ACTION_E67_RELEASE=active
KNOWLEDGE_PROMPT_ACTION_GENERIC_RELEASE=active
KNOWLEDGE_PROMPT_PERFORMANCE_RELEASE=active
KNOWLEDGE_PROMPT_ROUTER_RELEASE=active
KNOWLEDGE_PROMPT_TIMELINE_PARTIAL30_RELEASE=active
# A concrete release ID pins that unit instead of resolving the selected deployment.
# Apply to Action/Performance, GPU3 decision services and GPU4 Timeline; restart the owning service after selection.
