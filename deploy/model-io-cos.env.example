# Local NVMe spool mounted into each Omni model container and uploader sidecar.
SGLANG_OMNI_MODEL_IO_ROOT=/var/lib/sglang-omni/model-io
SGLANG_OMNI_MODEL_IO_QUEUE_SIZE=128
SGLANG_OMNI_MODEL_IO_MAX_BYTES=8589934592

# COS destination. Credentials must be injected through a root-readable secret
# file or the sidecar environment; never commit them to this file.
SGLANG_OMNI_MODEL_IO_COS_BUCKET=feamex-dev-bj-1323117700
SGLANG_OMNI_MODEL_IO_COS_REGION=ap-beijing
SGLANG_OMNI_MODEL_IO_COS_PREFIX=omni
SGLANG_OMNI_MODEL_IO_DATE_TIMEZONE=Asia/Shanghai
