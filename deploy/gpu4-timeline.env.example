# Copy to gpu4-timeline.env, replace the secret, and chmod 600.
CUDA_VISIBLE_DEVICES=4
SGLANG_OMNI_TIMELINE_DETECTION_TOKEN=replace-with-a-random-secret
SGLANG_OMNI_MODEL_MANIFEST=/data/fanshide/sglang-omni-dev/deploy/gpu4-timeline-model-release.json
SGLANG_OMNI_MODEL_VERSION=sha256:replace-with-manifest-sha256
SGLANG_OMNI_VERIFY_ARTIFACT_SHA256=1
SGLANG_OMNI_TIMELINE_MODEL_VERSION=event-v1.20
SGLANG_OMNI_TIMELINE_INFERENCE_INTERVAL_MS=3000
SGLANG_OMNI_TIMELINE_WINDOW_MS=10000
SGLANG_OMNI_TIMELINE_MAX_WINDOW_BYTES=33554432
SGLANG_OMNI_TIMELINE_MAX_PENDING_CHUNKS=16
SGLANG_OMNI_TIMELINE_MAX_PENDING_BYTES=33554432
GPU4_TIMELINE_CONFIG=/data/fanshide/sglang-omni-dev/deploy/config_gpu4_timeline.yaml
GPU4_TIMELINE_MODEL_NAME=qwen3-omni-gpu4-timeline
GPU4_TIMELINE_PORT=18008
